---
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';
import '@fontsource/inter-tight/500.css';
import '@fontsource/inter-tight/600.css';
import '@fontsource/inter-tight/700.css';
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/500.css';
import '../styles/landing.css';
import '../styles/motion.css';

import Nav from '../components/landing/Nav.astro';
import Hero from '../components/landing/Hero.astro';
import ContextGraph from '../components/landing/ContextGraph.astro';
import SoftwareFactory from '../components/landing/SoftwareFactory.astro';
import Pillars from '../components/landing/Pillars.astro';
import Commands from '../components/landing/Commands.astro';
import InstallBand from '../components/landing/InstallBand.astro';
import OpenSource from '../components/landing/OpenSource.astro';
import FinalCta from '../components/landing/FinalCta.astro';
import CommandMarquee from '../components/landing/CommandMarquee.astro';
import Footer from '../components/landing/Footer.astro';
import SeoHead from '../components/landing/SeoHead.astro';
---

<!doctype html>
<html lang="en">
<head>
<SeoHead
  title="devtwin · Clone the developer"
  description="devtwin is an open-source CLI that starts every Claude Code, Codex and Gemini CLI session with a short, cited brief of your project's decisions, constraints, commands and handoffs. It keeps everything on your disk and shows your team's lessons when an agent opens the code they're about."
/>
<!-- Motion gate, before first paint: motion is on unless prefers-reduced-motion asks otherwise. -->
<script is:inline>(function(){var r=document.documentElement,on=!(window.matchMedia&&matchMedia('(prefers-reduced-motion: reduce)').matches);r.classList.add('js',on?'m-on':'m-off')})();</script>
</head>
<body>
<a class="skip" href="#main">Skip to content</a>

<Nav />

<main id="main">
<Hero />
<SoftwareFactory />
<div class="landing-benefits wrap">
      <ul class="benefit-strip" aria-label="Why use devtwin">
        <li><strong>Resume the work.</strong><span>The next session starts with your last handoff.</span></li>
        <li><strong>Reuse the lesson.</strong><span>Bring what you learned to matching work.</span></li>
        <li><strong>Share the knowledge.</strong><span>Help your team learn, with your consent.</span></li>
      </ul>
</div>
<section class="context-detail" id="context-in-action" aria-labelledby="context-detail-title">
  <div class="wrap">
    <div class="context-detail-heading">
      <div class="kicker">How it works</div>
      <h2 class="h2" id="context-detail-title">The right context.<br /><span class="soft">In your next agent session.</span></h2>
      <p>See how your preferences, project decisions and lessons become a brief your agents can use.</p>
    </div>
    <div class="stage stage-wide reveal" id="context-graph" data-fit-graph>
      <div class="stage-inner"><ContextGraph /></div>
    </div>
  </div>
</section>
<Pillars />
<CommandMarquee />
<Commands />
<InstallBand />
<OpenSource />
<FinalCta />
</main>

<Footer />

<!-- Behaviour ported from the sample: reveal-on-scroll, copy buttons and the
     account switcher. Motion follows the html.m-on / html.m-off gate set in <head>. -->
<script is:inline>
(function(){
  document.documentElement.classList.add('js');
  var root = document.documentElement;
  var reduce = !root.classList.contains('m-on');

  // reveal on scroll
  var els = document.querySelectorAll('.reveal');
  if (reduce || !('IntersectionObserver' in window)) {
    els.forEach(function(e){ e.classList.add('in'); });
  } else {
    var io = new IntersectionObserver(function(entries){
      entries.forEach(function(en){ if (en.isIntersecting){ en.target.classList.add('in'); io.unobserve(en.target); } });
    }, {rootMargin:'0px 0px -8% 0px', threshold:.08});
    els.forEach(function(e){ io.observe(e); });
  }

  // copy buttons
  document.querySelectorAll('[data-copy]').forEach(function(b){
    b.addEventListener('click', function(){
      var t = b.getAttribute('data-copy');
      var done = function(){ b.textContent = 'Copied'; setTimeout(function(){ b.textContent = 'Copy'; }, 1600); };
      if (navigator.clipboard) navigator.clipboard.writeText(t).then(done, done); else done();
    });
  });

  // account switcher
  var data = {
    work:{cwd:'~/work/billing-service', gh:'@sam-work', ghOrg:'work', sl:'Sam R.', slWs:'work.slack.com', ln:'sam-work', lnWs:'work', cl:'work-prod', repo:'work/billing-service', wrong:'@sam-client'},
    client:{cwd:'~/client/mobile-app', gh:'@sam-client', ghOrg:'client', sl:'Sam', slWs:'client.slack.com', ln:'sam-client', lnWs:'client', cl:'client-staging', repo:'client/mobile-app', wrong:'@sam-work'}
  };
  var acct = document.getElementById('acct');
  var auto = true, timer;
  function setScope(s){
    var d = data[s];
    acct.dataset.scope = s;
    acct.querySelectorAll('.scope-switch button').forEach(function(b){ b.setAttribute('aria-pressed', b.dataset.scope === s); });
    document.getElementById('acct-cwd').innerHTML = 'cwd <b>' + d.cwd + '</b> → scope <b>' + s + '</b>';
    acct.querySelector('[data-gh]').innerHTML = d.gh + '<small>GitHub · ' + d.ghOrg + '</small>';
    acct.querySelector('[data-sl]').innerHTML = d.sl + '<small>Slack · ' + d.slWs + '</small>';
    acct.querySelector('[data-ln]').innerHTML = d.ln + '<small>Linear · ' + d.lnWs + '</small>';
    acct.querySelector('[data-cl]').innerHTML = d.cl + '<small>AWS · deploy role</small>';
    document.getElementById('r-repo').textContent = d.repo;
    document.getElementById('r-who').textContent = d.wrong;
    acct.querySelector('.refuse .muted').textContent = 'scope ' + s + ' is bound to ' + d.gh;
  }
  acct.querySelectorAll('.scope-switch button').forEach(function(b){
    b.addEventListener('click', function(){ auto = false; clearInterval(timer); setScope(b.dataset.scope); });
  });
  if (auto) {
    timer = setInterval(function(){
      if (!root.classList.contains('m-on')) return;
      var r = acct.getBoundingClientRect();
      if (r.top < innerHeight && r.bottom > 0) setScope(acct.dataset.scope === 'work' ? 'client' : 'work');
    }, 5000);
  }
})();
</script>
<script>
  import '../scripts/motion.ts';
</script>
</body>
</html>

<style>
.landing-benefits{padding-bottom:48px}
.context-detail{padding:32px 0 40px;scroll-margin-top:96px}
.context-detail-heading{max-width:760px}
.context-detail-heading .h2{font-size:clamp(30px,3.5vw,44px);line-height:1.1;margin-bottom:16px}
.context-detail-heading p{color:var(--muted);font-size:15px;line-height:1.8;max-width:600px}
.context-detail .stage{margin-top:28px;scroll-margin-top:96px}
.context-detail .stage[data-fitted]{width:var(--graph-width);margin-inline:auto;max-width:100%;padding:1px}
.context-detail .stage[data-fitted] .stage-inner{width:1440px;zoom:var(--graph-scale)}

.benefit-strip{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:28px;list-style:none;margin:0;padding:0;text-align:left}
.benefit-strip strong{display:block;font:500 17px var(--display);color:var(--text);margin-bottom:7px}
.benefit-strip span{display:block;font-size:13px;line-height:1.7;color:var(--muted)}
@media(max-width:600px){.benefit-strip{grid-template-columns:1fr;gap:18px}}
</style>

<script>
  // Scale the inner diagram; the unscaled stage retains its rendered footprint
  // for the page rail, border trace and normal document flow.
  const fitStage = document.querySelector<HTMLElement>('[data-fit-graph]');
  const fitInner = fitStage?.querySelector<HTMLElement>('.stage-inner');
  const fitNav = document.querySelector<HTMLElement>('.nav');
  if (fitStage && fitInner) {
    let queued = false;
    const reset = () => {
      fitStage.removeAttribute('data-fitted');
      fitStage.style.removeProperty('--graph-scale');
      fitStage.style.removeProperty('--graph-width');
    };
    const fit = () => {
      queued = false;
      if (innerWidth < 1024) { reset(); return; }
      const parent = fitStage.parentElement!;
      const padding = getComputedStyle(parent);
      const availableWidth = parent.clientWidth - parseFloat(padding.paddingLeft) - parseFloat(padding.paddingRight);
      fitStage.setAttribute('data-fitted', '');
      // Establish the natural desktop layout before measuring its height.
      fitStage.style.setProperty('--graph-scale', '.75');
      fitStage.style.setProperty('--graph-width', '1082px');
      const naturalHeight = fitInner.offsetHeight;
      const availableHeight = innerHeight - (fitNav?.offsetHeight ?? 80) - 36;
      const scale = Math.min(.85, (availableWidth - 2) / 1440, (availableHeight - 2) / naturalHeight);
      // Small windows keep the readable native layout and can scroll.
      if (!Number.isFinite(scale) || scale < .65) { reset(); return; }
      fitStage.style.setProperty('--graph-scale', String(scale));
      fitStage.style.setProperty('--graph-width', `${1440 * scale + 2}px`);
    };
    const scheduleFit = () => {
      if (!queued) { queued = true; requestAnimationFrame(fit); }
    };
    new ResizeObserver(scheduleFit).observe(fitStage.parentElement!);
    if (fitNav) new ResizeObserver(scheduleFit).observe(fitNav);
    addEventListener('resize', scheduleFit);
    document.fonts.ready.then(scheduleFit);
    scheduleFit();
  }
</script>
